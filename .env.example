# The live site works in demo mode without these values.
# Add them to enable real Dodo Payments checkout and verified ownership confirmation.
#
# Get these from the Dodo Payments dashboard (https://app.dodopayments.com).
# The product referenced by DODO_PAYMENTS_PRODUCT_ID must have "pay what you want"
# pricing enabled so each bid/total can be charged as a custom amount.
DODO_PAYMENTS_API_KEY=h1JlJdNKjYJBKWaT.MYz6Whdvd2anZJM1yWb1asldCkZvy0uc7qURTUy0bmNG065p
# Optional. If omitted or if this points to a fixed-price product, the app
# creates and remembers one reusable Pay What You Want product automatically.
DODO_PAYMENTS_PRODUCT_ID=pdt_0NmM4X2fq6dZFJR3RtWL7

# "test" (default) or "live"
DODO_PAYMENTS_ENVIRONMENT=test
# Used to verify incoming Dodo webhooks (payment confirmation).
DODO_PAYMENTS_WEBHOOK_SECRET=whsec_Qp7Uz3tTVytwGiFdjUhVbg3O5gRWGPYh

# Public origin used in checkout redirects and social metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Canonical scarcity clock. V1 is intentionally one shared UTC timeline.
BUY1MINUTE_TIMEZONE=UTC
